# --- workspace / IO -----------------------------------------------------
AEGIS_WORKSPACE_ROOT=./workspace
AEGIS_OUTPUT_DIR=./var/packages
AEGIS_WORK_DIR=./var/work
AEGIS_MAX_FILE_BYTES=2000000

# --- scanning -----------------------------------------------------------
AEGIS_OPENGREP_BIN=opengrep
AEGIS_OPENGREP_FALLBACK_BIN=semgrep
AEGIS_SCAN_TIMEOUT_S=900

# --- lsp ----------------------------------------------------------------
AEGIS_LSP_ENABLED=true
# AEGIS_LSP_CONFIG_FILE=./docker/lsp.yaml
AEGIS_LSP_REQUEST_TIMEOUT_S=20

# --- budget (nested settings use a double underscore) -------------------
AEGIS_BUDGET__MAX_DEPTH=2
AEGIS_BUDGET__MAX_NODES=60
AEGIS_BUDGET__MAX_CALLERS_PER_NODE=8
AEGIS_BUDGET__MAX_CALLEES_PER_NODE=12
AEGIS_BUDGET__MAX_IMPLEMENTATIONS=5
AEGIS_BUDGET__MAX_LINES_PER_METHOD=400
AEGIS_BUDGET__MAX_CHARS_PER_METHOD=24000
AEGIS_BUDGET__MAX_TOTAL_CHARS=600000
AEGIS_BUDGET__MAX_CONTEXTS=20
AEGIS_BUDGET__EXPAND_CONCURRENCY=6

# --- logging ------------------------------------------------------------
AEGIS_LOG_LEVEL=INFO
AEGIS_LOG_JSON=false

# --- job queue ----------------------------------------------------------
# Unset AEGIS_QUEUE__REDIS_URL -> no queue: POST /v1/assemble stays synchronous and
# nothing needs a broker. Set it to run the async job path (see docs/QUEUE_PLAN.md).
# AEGIS_QUEUE__REDIS_URL=redis://redis:6379/0
# AEGIS_QUEUE__VISIBILITY_TIMEOUT_S=1800
# AEGIS_QUEUE__HEARTBEAT_INTERVAL_S=15
# AEGIS_QUEUE__REAPER_INTERVAL_S=30
# AEGIS_QUEUE__MAX_ATTEMPTS=3
# AEGIS_QUEUE__JOB_TTL_S=604800
# AEGIS_QUEUE__STREAM_MAXLEN=10000
# AEGIS_QUEUE__CANCEL_TERMINATE_GRACE_S=3
# AEGIS_QUEUE__CANCEL_KILL_GRACE_S=2

# --- compose only -------------------------------------------------------
# Host path mounted at /workspace inside the containers.
AEGIS_SCAN_TARGET=./demo/repo
# Host port for the gateway, the only API published to the host.
# 127.0.0.1 only: the workers publish nothing, and nothing binds 0.0.0.0.
AEGIS_GATEWAY_PORT=8100
# Host port for the review console (nginx + static assets; it proxies nothing).
AEGIS_FRONTEND_PORT=8102
# Where that console tells the browser the API is. It must be the gateway *as the browser sees
# it*, which is the published host port above -- not the compose service name, because the
# request is made by the browser and not by the container. Change this when the console is
# served from another machine; nothing else about the image changes.
# AEGIS_FRONTEND_API_BASE=http://127.0.0.1:8100
# Which origins the gateway accepts. The console is cross-origin by design, so its origin has
# to be here -- a wildcard keeps local work frictionless, and a deployment should name it.
# AEGIS_CORS__ALLOW_ORIGINS='["*"]'



API_URL=
API_KEY=
# `AEGIS_AI_MODEL`, not `MODEL`. Compose gives the *shell* environment precedence over
# `--env-file`, so a stray `MODEL` in the operator's session silently overrode this file and
# changed which model the deployment actually used. A name of its own cannot be shadowed.
AEGIS_AI_MODEL=glm-5.3-flash

# Model calls in flight. The app's default is 1; raising it trades reliability for wall clock
# (measured: six concurrent calls behind a ~60s gateway ceiling returned 3 usable answers where
# six sequential returned 6). See `docs/AI_STAGE.md`.
AEGIS_AI_CONCURRENCY=8

# Per-call output ceiling. Unset, the provider's own default applies -- and on a real module audit
# that default cut 87 of 151 retry turns in half, each one a long `final` object discarded and then
# re-emitted. 16384 also covers a *batched* judging run: four verdicts do not fit in 8192 (measured
# on a quick run, where every `batch(4)` call came back at exactly 8192 tokens and looped until the
# run errored). `0` means "let the provider decide".
AEGIS_AI_MAX_TOKENS=16384

# Run-wide audit limits. Zero disables a time/call/token/cost limit.
# Tokens and USD stop subsequent requests; concurrent requests already sent may overshoot.
# USD requires configured per-million-token rates and provider usage; missing usage stops the run.
AEGIS_HARNESS_MAX_RUN_SECONDS=7200
AEGIS_HARNESS_MAX_MODEL_CALLS=512
AEGIS_HARNESS_MAX_MODEL_TOKENS=0
AEGIS_HARNESS_MAX_COST_USD=0
AEGIS_HARNESS_INPUT_USD_PER_MILLION=0
AEGIS_HARNESS_OUTPUT_USD_PER_MILLION=0
AEGIS_HARNESS_MAX_CLAIM_ATTEMPTS=3
AEGIS_HARNESS_MAX_GAP_CONTINUATIONS=2
AEGIS_HARNESS_MAX_NO_PROGRESS_CONTINUATIONS=1
