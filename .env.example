# --- workspace / IO -----------------------------------------------------
AEGIS_WORKSPACE_ROOT=./workspace
AEGIS_OUTPUT_DIR=./var/packages
AEGIS_WORK_DIR=./var/work
AEGIS_MAX_FILE_BYTES=2000000

# --- scanning -----------------------------------------------------------
AEGIS_OPENGREP_BIN=opengrep
AEGIS_OPENGREP_FALLBACK_BIN=semgrep
AEGIS_SCAN_TIMEOUT_S=900

# --- lsp ----------------------------------------------------------------
AEGIS_LSP_ENABLED=true
# AEGIS_LSP_CONFIG_FILE=./docker/lsp.yaml
AEGIS_LSP_REQUEST_TIMEOUT_S=20

# --- budget (nested settings use a double underscore) -------------------
AEGIS_BUDGET__MAX_DEPTH=2
AEGIS_BUDGET__MAX_NODES=60
AEGIS_BUDGET__MAX_CALLERS_PER_NODE=8
AEGIS_BUDGET__MAX_CALLEES_PER_NODE=12
AEGIS_BUDGET__MAX_IMPLEMENTATIONS=5
AEGIS_BUDGET__MAX_LINES_PER_METHOD=400
AEGIS_BUDGET__MAX_CHARS_PER_METHOD=24000
AEGIS_BUDGET__MAX_TOTAL_CHARS=600000
AEGIS_BUDGET__MAX_CONTEXTS=20
AEGIS_BUDGET__EXPAND_CONCURRENCY=6

# --- logging ------------------------------------------------------------
AEGIS_LOG_LEVEL=INFO
AEGIS_LOG_JSON=false

# --- compose only -------------------------------------------------------
# Host path mounted at /workspace inside the containers.
AEGIS_SCAN_TARGET=./demo/repo
# Host port for the gateway, the only API published to the host.
# 127.0.0.1 only: the workers publish nothing, and nothing binds 0.0.0.0.
AEGIS_GATEWAY_PORT=8100
