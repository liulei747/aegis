# --- python -------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
secaudit-scans/

# --- local runtime state -------------------------------------------------
# `var/` is runtime output, but `var/jdtls/` is the local jdtls snapshot the compose build
# mounts as an additional build context. The tarball stays ignored (the operator downloads it
# through the system proxy into var/jdtls/jdt-language-server.tar.gz); the directory is kept so
# a clone can still `docker compose build` without the context path being missing. The same
# exclusion-re-entry pattern as demo/ below: git never descends into an excluded directory.
var/*
!var/jdtls/
var/jdtls/*.tar.gz
workspace/
# The demo workspace is checked in on purpose: docker-compose.yml mounts
# ../demo/repo, and while that directory is ignored Docker creates an *empty* one
# and scans it, producing a normal-looking empty bundle with no error at all.
# Everything else under demo/ is generated by scripts/demo.py and stays ignored:
# lsp.yaml holds this machine's interpreter path, scan.sarif is a build product.
# Note the form: ignoring `demo/` as a whole would make the negation impossible,
# because git never descends into an excluded directory.
demo/*
!demo/repo/
demo/repo/__pycache__/
.env
docker/lsp.local.yaml

# --- node / the console --------------------------------------------------
# `node_modules` is restored by `npm ci`, and `dist` is what the nginx image builds from
# source. `package-lock.json` is deliberately NOT ignored: it is what makes that install
# reproducible, and an unpinned front-end build is how a page starts failing on a Tuesday.
node_modules/
frontend/dist/
# A developer's own API address. `.env.development` IS committed, because `npm run dev` working
# out of the box is worth more than each developer rediscovering the variable.
frontend/.env.local
frontend/.env.*.local
benchamrk/

# --- editor / os ---------------------------------------------------------
.idea/
.vscode/
.DS_Store
Thumbs.db

