{
  "name": "aegis-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Aegis front-end: a separately deployable client of the gateway's HTTP API.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types \"test/*.test.ts\"",
    "snapshot": "node --experimental-strip-types scripts/openapi-snapshot.ts"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.9.3",
    "vite": "5.4.11"
  }
}
